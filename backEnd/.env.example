# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed or shared.

# Server
PORT=5000

# Database — each developer runs their own MySQL and their own database
DB_HOST=127.0.0.1
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
# Only needed for a cloud database (Aiven, TiDB...). Leave out when local.
# DB_PORT=3306
# DB_SSL=true

# JWT — any long random string. Use a different one per developer.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Rate limits
# Login + register attempts allowed per IP address in 15 minutes
AUTH_RATE_LIMIT_PER_15_MIN=10
# Draft coach + answer fit requests allowed per user per minute
AI_RATE_LIMIT_PER_MIN=10

# Gemini — get your own key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Semantic search: minimum cosine score for a search result
RECOMMEND_THRESHOLD=0.62
# Related questions: minimum cosine score (stricter, because they show up unasked)
RELATED_THRESHOLD=0.75

# Semantic search: how many similar questions to return when the request does not say
RECOMMEND_K=5

# Profile photos
PROFILE_UPLOAD_DIR=uploads/profiles
PROFILE_MAX_UPLOAD_MB=2

# RAG (user-owned PDFs)
# Where PDFs are stored on disk, relative to the backEnd folder
RAG_UPLOAD_DIR=uploads/rag
# Max upload size in megabytes
RAG_MAX_UPLOAD_MB=10
# Chunking: character window and overlap between windows
RAG_CHUNK_CHARS=1000
RAG_CHUNK_OVERLAP=150
# Safety caps per document / per user
RAG_MAX_CHUNKS_PER_DOC=1000
RAG_MAX_PDFS_PER_USER=20
# Minimum extracted characters before a PDF counts as usable text
RAG_MIN_TEXT_CHARS=50
# Chunk search: minimum cosine score and max hits returned
RAG_SEARCH_THRESHOLD=0.45
RAG_SEARCH_K=10
